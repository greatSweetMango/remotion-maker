# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# SQLite database
prisma/*.db
prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# agent-state runtime files (not tracked, but dir is tracked via README)
.agent-state/loop-count
.agent-state/context-*.md
.agent-state/STOP
.agent-state/dashboard.json
.agent-state/dashboard-logs/
# TM-209 — tasks.json single-writer mutex runtime anchors (never tracked)
.agent-state/.tasks.lock
.agent-state/.tasks.mutex.d/
# TM-215 — set-current-task.sh runtime anchor; tracking it caused repeated
# merge/pull conflicts across concurrent TeamLead PRs (orchestrator-v2 wave1).
.agent-state/current-task
# TM-208 — ci-gate.sh chronically-red telemetry (runtime, best-effort, never tracked)
.agent-state/ci-gate-red-history.jsonl

# git worktrees (per-task isolated directories, managed by PM agent)
/worktrees/
.playwright-mcp/

# TM-84 spike — live OpenAI asset outputs, never commit.
/.spike-assets/

# TM-90 — runtime-generated PNGs from asset-gen stage. User-uploaded
# thumbnails (TM-109) and asset-gen outputs share public/uploads/ but
# are filesystem-only (regenerable / re-uploadable).
/public/uploads/
